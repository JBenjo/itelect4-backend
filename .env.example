# .env.example  -- committed, so anyone who clones knows what to fill in
MONGODB_URI=
JWT_SECRET=
# From aistudio.google.com -> Get API key. Server-side only: it is
# never sent to the browser, and never committed. The quota belongs to
# the Google project behind the key, so keep your own.
GEMINI_API_KEY=
PORT=4000
# Comma-separated list of origins allowed to call this API (CORS).
CORS_ORIGIN=http://localhost:5173
# Comma-separated DNS servers used when the OS default fails to resolve
# mongodb+srv:// SRV records (e.g. VPN/proxy left 127.0.0.1 as the resolver).
DNS_SERVERS=
